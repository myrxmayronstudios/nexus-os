# Enforce LF line endings for all shell scripts and configuration files.
# This is critical because these files run on Linux (host or container).

# Shell scripts
*.sh text eol=lf

# Configuration files
*.conf text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.css text eol=lf

# Dockerfiles
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# Markdown & docs
*.md text eol=lf
*.txt text eol=lf

# Git config
.gitattributes text eol=lf
.gitignore text eol=lf

# Makefiles
Makefile text eol=lf
*.mk text eol=lf

# Binary files — do not modify
*.img binary
*.img.xz binary
*.iso binary
*.gz binary
*.bz2 binary
*.tar binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
