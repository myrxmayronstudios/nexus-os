# ============================================================================
# Neuxon OS - Stealth Monochrome Plymouth Boot Theme Script
# Pitch Black #050505 canvas with minimalist white geometric logo & progress bar
# ============================================================================

# Background: Void Black (#050505 ≈ 0.020, 0.020, 0.020)
Window.SetBackgroundTopColor(0.020, 0.020, 0.020);
Window.SetBackgroundBottomColor(0.020, 0.020, 0.020);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
center_x = screen_width / 2;
center_y = screen_height / 2;

# Title logo: "◆  N E U X O N   O S"
title_image = Image.Text("◆   N E U X O N   O S", 1.0, 1.0, 1.0, 1, "Monospace 24");
title_sprite = Sprite(title_image);
title_sprite.SetX(center_x - title_image.GetWidth() / 2);
title_sprite.SetY(center_y - 60);
title_sprite.SetZ(10);

# Subtitle: "BCM2837B0 // 64-BIT STEALTH MONOCHROME"
subtitle_image = Image.Text("BCM2837B0 // 64-BIT STEALTH MONOCHROME", 0.48, 0.48, 0.48, 1, "Monospace 11");
subtitle_sprite = Sprite(subtitle_image);
subtitle_sprite.SetX(center_x - subtitle_image.GetWidth() / 2);
subtitle_sprite.SetY(center_y - 14);
subtitle_sprite.SetZ(10);

# Progress bar
progress_bar_width = 280;
progress_bar_height = 2;
progress_bar_y = center_y + 40;
progress_bar_x = center_x - progress_bar_width / 2;

# Track outline
track_img = Image(progress_bar_width, progress_bar_height);
for (x = 0; x < progress_bar_width; x++) {
    track_img.SetPixel(x, 0, 0.16, 0.16, 0.16, 1);
    track_img.SetPixel(x, 1, 0.16, 0.16, 0.16, 1);
}
track_sprite = Sprite(track_img);
track_sprite.SetX(progress_bar_x);
track_sprite.SetY(progress_bar_y);
track_sprite.SetZ(5);

# Active progress fill
progress_sprites = [];
for (i = 0; i < progress_bar_width; i++) {
    pix_img = Image(1, progress_bar_height);
    pix_img.SetPixel(0, 0, 1.0, 1.0, 1.0, 1);
    pix_img.SetPixel(0, 1, 1.0, 1.0, 1.0, 1);
    progress_sprites[i] = Sprite(pix_img);
    progress_sprites[i].SetX(progress_bar_x + i);
    progress_sprites[i].SetY(progress_bar_y);
    progress_sprites[i].SetZ(6);
    progress_sprites[i].SetOpacity(0);
}

fun progress_callback(duration, progress) {
    visible_pixels = Math.Int(progress * progress_bar_width);
    for (i = 0; i < progress_bar_width; i++) {
        if (i < visible_pixels) {
            progress_sprites[i].SetOpacity(1);
        } else {
            progress_sprites[i].SetOpacity(0);
        }
    }
}
Plymouth.SetBootProgressFunction(progress_callback);

# Quit callback
fun quit_callback() {
    title_sprite.SetOpacity(0);
    subtitle_sprite.SetOpacity(0);
    track_sprite.SetOpacity(0);
    for (i = 0; i < progress_bar_width; i++) {
        progress_sprites[i].SetOpacity(0);
    }
}
Plymouth.SetQuitFunction(quit_callback);
