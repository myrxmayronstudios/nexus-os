[Desktop Entry]
Name=Neuxon Control Center
Comment=Performance profiles, Wi-Fi, updates and display configuration
Exec=foot -a neuxon-control -T "Neuxon Control Center" /usr/local/bin/neuxon-control
Icon=preferences-system
Terminal=false
