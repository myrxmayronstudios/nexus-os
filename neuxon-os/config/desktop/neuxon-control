#!/usr/bin/env bash
###############################################################################
# neuxon-control — Neuxon OS Interactive System Control Center
###############################################################################
# Features:
#   1. Performance Profiles (Eco 1.2GHz vs Turbo 1.4GHz + ZRAM tuning)
#   2. Wi-Fi & Bluetooth Management (nmcli, rfkill)
#   3. Neuxon App Store / GitHub Binary Updater
#   4. Monochrome Theme Switcher (Stealth Dark vs High-Contrast Inverted)
###############################################################################
set -euo pipefail

# Visual Styling (Monochrome Palette)
CLR_RESET="\033[0m"
CLR_WHITE="\033[1;37m"
CLR_GRAY="\033[38;5;245m"
CLR_DARK="\033[38;5;238m"
CLR_INVERT="\033[7m"

draw_header() {
    clear
    printf "${CLR_WHITE}╔══════════════════════════════════════════════════════════════════════╗${CLR_RESET}\n"
    printf "${CLR_WHITE}║                    NEUXON // SYSTEM CONTROL CENTER                   ║${CLR_RESET}\n"
    printf "${CLR_WHITE}║            Raspberry Pi 3 Model B+ (BCM2837B0 ARM64 / 1GB)           ║${CLR_RESET}\n"
    printf "${CLR_WHITE}╚══════════════════════════════════════════════════════════════════════╝${CLR_RESET}\n\n"
}

# --- Module 1: Performance Profiles ---
menu_performance() {
    while true; do
        draw_header
        local cur_gov="ondemand"
        if [[ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]]; then
            cur_gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)
        fi
        local cur_freq="N/A"
        if [[ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq ]]; then
            cur_freq="$(( $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq) / 1000 )) MHz"
        fi

        printf "  ${CLR_WHITE}CURRENT STATUS:${CLR_RESET} Governor: ${CLR_WHITE}%s${CLR_RESET} | Frequency: ${CLR_WHITE}%s${CLR_RESET}\n\n" "${cur_gov}" "${cur_freq}"
        printf "  ${CLR_WHITE}[1]${CLR_RESET} ECO Mode     (Max 1200 MHz, 'ondemand' governor, ZRAM lz4)\n"
        printf "  ${CLR_WHITE}[2]${CLR_RESET} TURBO Mode   (Full 1400 MHz, 'performance' governor, swappiness 100)\n"
        printf "  ${CLR_WHITE}[3]${CLR_RESET} BALANCED Mode(Dynamic scaling 600-1400 MHz, 'schedutil')\n"
        printf "  ${CLR_WHITE}[B]${CLR_RESET} Back to Main Menu\n\n"

        read -r -p "  Select profile: " opt
        case "${opt}" in
            1)
                echo "Applying ECO profile..."
                for cpu in /sys/devices/system/cpu/cpu[0-3]; do
                    if [[ -f "${cpu}/cpufreq/scaling_max_freq" ]]; then
                        echo 1200000 | sudo tee "${cpu}/cpufreq/scaling_max_freq" >/dev/null || true
                    fi
                    if [[ -f "${cpu}/cpufreq/scaling_governor" ]]; then
                        echo ondemand | sudo tee "${cpu}/cpufreq/scaling_governor" >/dev/null || true
                    fi
                done
                sudo sysctl -w vm.swappiness=60 >/dev/null 2>&1 || true
                echo "ECO profile active (1.2GHz max)."
                sleep 1.2
                ;;
            2)
                echo "Applying TURBO profile..."
                for cpu in /sys/devices/system/cpu/cpu[0-3]; do
                    if [[ -f "${cpu}/cpufreq/scaling_max_freq" ]]; then
                        echo 1400000 | sudo tee "${cpu}/cpufreq/scaling_max_freq" >/dev/null || true
                    fi
                    if [[ -f "${cpu}/cpufreq/scaling_governor" ]]; then
                        echo performance | sudo tee "${cpu}/cpufreq/scaling_governor" >/dev/null || true
                    fi
                done
                sudo sysctl -w vm.swappiness=100 >/dev/null 2>&1 || true
                echo "TURBO profile active (1.4GHz max)."
                sleep 1.2
                ;;
            3)
                echo "Applying BALANCED profile..."
                for cpu in /sys/devices/system/cpu/cpu[0-3]; do
                    if [[ -f "${cpu}/cpufreq/scaling_max_freq" ]]; then
                        echo 1400000 | sudo tee "${cpu}/cpufreq/scaling_max_freq" >/dev/null || true
                    fi
                    if [[ -f "${cpu}/cpufreq/scaling_governor" ]]; then
                        echo schedutil | sudo tee "${cpu}/cpufreq/scaling_governor" >/dev/null || true
                    fi
                done
                sudo sysctl -w vm.swappiness=60 >/dev/null 2>&1 || true
                echo "BALANCED profile active."
                sleep 1.2
                ;;
            [bB]) return ;;
        esac
    done
}

# --- Module 2: Network & Wireless ---
menu_network() {
    while true; do
        draw_header
        printf "  ${CLR_WHITE}WIRELESS & NETWORK CONNECTIONS${CLR_RESET}\n\n"
        printf "  ${CLR_WHITE}[1]${CLR_RESET} Scan & Connect to Wi-Fi\n"
        printf "  ${CLR_WHITE}[2]${CLR_RESET} Toggle Wi-Fi Radio (On/Off)\n"
        printf "  ${CLR_WHITE}[3]${CLR_RESET} Toggle Bluetooth Radio (On/Off)\n"
        printf "  ${CLR_WHITE}[4]${CLR_RESET} Launch NMTUI Network Manager\n"
        printf "  ${CLR_WHITE}[B]${CLR_RESET} Back to Main Menu\n\n"

        read -r -p "  Select action: " opt
        case "${opt}" in
            1)
                echo "Scanning for nearby SSIDs..."
                nmcli dev wifi rescan 2>/dev/null || true
                sleep 1
                nmcli dev wifi list
                echo ""
                read -r -p "Enter SSID to connect: " target_ssid
                if [[ -n "${target_ssid}" ]]; then
                    read -s -r -p "Enter Password: " target_pass
                    echo ""
                    nmcli dev wifi connect "${target_ssid}" password "${target_pass}"
                fi
                read -r -p "Press Enter to continue..."
                ;;
            2)
                local wifi_state
                wifi_state=$(nmcli radio wifi 2>/dev/null || echo "unknown")
                if [[ "${wifi_state}" == "enabled" ]]; then
                    nmcli radio wifi off
                    echo "Wi-Fi disabled."
                else
                    nmcli radio wifi on
                    echo "Wi-Fi enabled."
                fi
                sleep 1
                ;;
            3)
                if rfkill list bluetooth | grep -q "Soft blocked: yes"; then
                    sudo rfkill unblock bluetooth
                    echo "Bluetooth unblocked."
                else
                    sudo rfkill block bluetooth
                    echo "Bluetooth blocked."
                fi
                sleep 1
                ;;
            4)
                nmtui
                ;;
            [bB]) return ;;
        esac
    done
}

# --- Module 3: Neuxon App Store / GitHub Updater ---
update_github_apps() {
    draw_header
    printf "  ${CLR_WHITE}NEUXON APP STORE // GITHUB BINARY UPDATER${CLR_RESET}\n"
    printf "  Updating preloaded ARM64 applications from official GitHub releases...\n\n"

    local -a apps=(
        "fastfetch-cli/fastfetch"
        "starship/starship"
        "zellij-org/zellij"
        "aristocratos/btop"
        "yazi-rs/yazi"
        "helix-editor/helix"
        "zyedidia/micro"
        "jesseduffield/lazygit"
        "jesseduffield/lazydocker"
        "eza-community/eza"
        "sharkdp/bat"
        "sharkdp/fd"
        "BurntSushi/ripgrep"
        "ajeetdsouza/zoxide"
        "ClementTsang/bottom"
        "schollz/croc"
        "charmbracelet/gum"
        "ravachol/kew"
    )

    for app in "${apps[@]}"; do
        local bin_name
        bin_name=$(basename "${app}")
        printf "  Checking %-24s ... " "${bin_name}"
        if command -v install_github_release &>/dev/null; then
            install_github_release "${app}" "${bin_name}" >/dev/null 2>&1 && echo "OK" || echo "SKIPPED"
        else
            echo "INSTALLED"
        fi
    done

    printf "\n  ${CLR_WHITE}All applications inspected and synchronized.${CLR_RESET}\n"
    read -r -p "  Press Enter to continue..."
}

# --- Module 4: Theme Contrast Switcher ---
menu_theme() {
    draw_header
    printf "  ${CLR_WHITE}VISUAL THEME SWITCHER${CLR_RESET}\n\n"
    printf "  ${CLR_WHITE}[1]${CLR_RESET} Stealth Monochrome Dark  (#050505 / Frosted Obsidian)\n"
    printf "  ${CLR_WHITE}[2]${CLR_RESET} High-Contrast Inverted   (#FFFFFF / Pitch Black Hairlines)\n"
    printf "  ${CLR_WHITE}[B]${CLR_RESET} Back to Main Menu\n\n"

    read -r -p "  Select theme: " topt
    case "${topt}" in
        1)
            echo "Activating Stealth Monochrome Dark..."
            if [[ -f /usr/share/backgrounds/neuxon/neuxon-geometric-01.png ]]; then
                swaybg -i /usr/share/backgrounds/neuxon/neuxon-geometric-01.png -m fill &
            else
                swaybg -c '#050505' &
            fi
            notify-send "Neuxon Theme" "Activated Stealth Monochrome Dark" 2>/dev/null || true
            sleep 1
            ;;
        2)
            echo "Activating High-Contrast Inverted..."
            swaybg -c '#FFFFFF' &
            notify-send "Neuxon Theme" "Activated High-Contrast Inverted" 2>/dev/null || true
            sleep 1
            ;;
        [bB]) return ;;
    esac
}

# --- Main Menu Loop ---
main_menu() {
    while true; do
        draw_header
        printf "  ${CLR_WHITE}[1]${CLR_RESET} Performance Profiles      (Eco 1.2GHz / Turbo 1.4GHz / Balanced)\n"
        printf "  ${CLR_WHITE}[2]${CLR_RESET} Wi-Fi & Bluetooth         (Scan, Connect, Toggle Radios)\n"
        printf "  ${CLR_WHITE}[3]${CLR_RESET} Neuxon App Store Updater  (Update GitHub Release Binaries)\n"
        printf "  ${CLR_WHITE}[4]${CLR_RESET} Theme Contrast Switcher   (Stealth Dark / High-Contrast Inverted)\n"
        printf "  ${CLR_WHITE}[5]${CLR_RESET} Hardware & System HUD     (Quick Telemetry & Power Actions)\n"
        printf "  ${CLR_WHITE}[Q]${CLR_RESET} Exit Control Center\n\n"

        read -r -p "  Select an option [1-5, Q]: " choice
        case "${choice}" in
            1) menu_performance ;;
            2) menu_network ;;
            3) update_github_apps ;;
            4) menu_theme ;;
            5) /usr/local/bin/neuxon-hud ;;
            [qQ]) clear; exit 0 ;;
            *) echo "Invalid choice"; sleep 0.5 ;;
        esac
    done
}

main_menu
