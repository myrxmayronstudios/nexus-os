# ============================================================================
# Neuxon OS - Stealth Monochrome Glass Mako Configuration
# Position: Top-right | Surface: Frosted Obsidian rgba(14, 14, 14, 0.86)
# Borders: 1px Specular Hairline (#2A2A2A / #FFFFFF on critical)
# ============================================================================

font=JetBrains Mono Nerd Font 10
background-color=#0E0E0EDB
text-color=#F5F5F5
border-color=#2A2A2A
border-size=1
border-radius=6
width=340
height=120
margin=14
padding=12
icons=0
max-icon-size=32
default-timeout=5000
group-by=summary
layer=overlay
anchor=top-right

[urgency=low]
border-color=#2A2A2A
text-color=#7A7A7A

[urgency=normal]
border-color=#FFFFFF
text-color=#F5F5F5

[urgency=critical]
border-color=#FFFFFF
text-color=#FFFFFF
background-color=#141414EE
default-timeout=0
