# ============================================================================
# Neuxon OS v5.0 - Stealth 16-Bit Obsidian Glass Mako Notification Configuration
# Position: Bottom-right | Action Center Style | 4s Auto-Dismiss
# ============================================================================

font=JetBrains Mono 10
background-color=#0A0D12E6
text-color=#F1F5F9
border-color=#8A96A8
border-size=1
border-radius=8
width=360
height=140
margin=16
padding=14
icons=1
max-icon-size=32
default-timeout=4000
group-by=summary
layer=overlay
anchor=bottom-right

[urgency=low]
border-color=#1E242F
text-color=#94A3B8

[urgency=normal]
border-color=#8A96A8
text-color=#F1F5F9

[urgency=critical]
border-color=#F87171
text-color=#FFFFFF
background-color=#180D12F0
default-timeout=0
