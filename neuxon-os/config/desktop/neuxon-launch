#!/usr/bin/env bash
# ============================================================================
# Neuxon OS - Fault-Tolerant Universal Application Launcher
# Intercepts app launches, provides fallback binaries, and guarantees sizing
# ============================================================================
set -u

LOGFILE="/tmp/neuxon-heal.log"
TIMESTAMP() { date +"%Y-%m-%d %H:%M:%S"; }

log_heal() {
    echo "[$(TIMESTAMP)] [LAUNCH-FALLBACK] $1" >> "${LOGFILE}"
}

APP="${1:-}"
shift || true

case "${APP}" in
    browser|web|chromium|chromium-browser|google-chrome|min)
        if [ -x /usr/local/bin/neuxon-browser ]; then
            exec /usr/local/bin/neuxon-browser "$@"
        elif command -v chromium-browser >/dev/null 2>&1; then
            exec chromium-browser --ozone-platform=wayland "$@"
        elif command -v chromium >/dev/null 2>&1; then
            exec chromium --ozone-platform=wayland "$@"
        elif command -v min >/dev/null 2>&1; then
            exec min "$@"
        elif [ -x /opt/Min/min ]; then
            exec /opt/Min/min "$@"
        elif command -v firefox-esr >/dev/null 2>&1; then
            exec firefox-esr "$@"
        else
            log_heal "No GUI browser installed; spawning Lynx/w3m fallback"
            foot --app-id=neuxon-browser --window-size-chars=104x32 -e sh -c "if command -v w3m >/dev/null; then w3m https://duckduckgo.com; elif command -v lynx >/dev/null; then lynx https://duckduckgo.com; else echo 'No browser installed. Run: sudo apt install chromium'; exec sh; fi"
        fi
        ;;

    terminal|term|foot)
        if command -v foot >/dev/null 2>&1; then
            exec foot "$@"
        elif command -v alacritty >/dev/null 2>&1; then
            exec alacritty "$@"
        else
            log_heal "foot not found, using generic x-terminal-emulator"
            exec x-terminal-emulator "$@"
        fi
        ;;

    btop|monitor)
        exec /usr/local/bin/btop "$@"
        ;;

    btm|bottom)
        if command -v btm >/dev/null 2>&1; then
            exec foot --app-id=neuxon-btop --window-size-chars=98x30 -e btm "$@"
        else
            exec /usr/local/bin/neuxon-launch btop "$@"
        fi
        ;;

    files|filemanager|yazi)
        if command -v yazi >/dev/null 2>&1; then
            exec foot --app-id=neuxon-files --window-size-chars=104x32 -e yazi "$@"
        elif command -v mc >/dev/null 2>&1; then
            log_heal "yazi missing, falling back to Midnight Commander"
            exec foot --app-id=neuxon-files --window-size-chars=104x32 -e mc "$@"
        elif command -v pcmanfm >/dev/null 2>&1; then
            log_heal "yazi missing, falling back to pcmanfm"
            exec pcmanfm "$@"
        elif command -v ranger >/dev/null 2>&1; then
            exec foot --app-id=neuxon-files --window-size-chars=104x32 -e ranger "$@"
        else
            log_heal "No file manager found, falling back to shell explorer"
            exec foot --app-id=neuxon-files --window-size-chars=104x32 -e sh -c "ls -la; exec bash"
        fi
        ;;

    mc|midnight-commander)
        if command -v mc >/dev/null 2>&1; then
            exec foot --app-id=neuxon-files --window-size-chars=104x32 -e mc "$@"
        else
            exec /usr/local/bin/neuxon-launch files "$@"
        fi
        ;;

    pcmanfm)
        if command -v pcmanfm >/dev/null 2>&1; then
            exec pcmanfm "$@"
        else
            exec /usr/local/bin/neuxon-launch files "$@"
        fi
        ;;

    music|audio|player|cmus|kew)
        if command -v cmus >/dev/null 2>&1; then
            exec foot --app-id=neuxon-music --window-size-chars=96x28 -e cmus "$@"
        elif command -v kew >/dev/null 2>&1; then
            exec foot --app-id=neuxon-music --window-size-chars=96x28 -e kew "$@"
        elif command -v mpv >/dev/null 2>&1; then
            exec foot --app-id=neuxon-music --window-size-chars=80x20 -e mpv --player-operation-mode=pseudo-gui "$@"
        else
            log_heal "No dedicated music player found"
            exec foot --app-id=neuxon-music --window-size-chars=80x16 -e sh -c "echo 'No audio player installed. Run: sudo apt install cmus'; read -r _"
        fi
        ;;

    image|photo|viewer|imv)
        if command -v imv >/dev/null 2>&1; then
            exec imv "$@"
        elif command -v feh >/dev/null 2>&1; then
            exec feh "$@"
        else
            log_heal "No image viewer found, falling back to mpv"
            exec mpv --image-display-duration=inf "$@"
        fi
        ;;

    pdf|document|reader|zathura)
        if command -v zathura >/dev/null 2>&1; then
            exec zathura "$@"
        elif command -v evince >/dev/null 2>&1; then
            exec evince "$@"
        else
            log_heal "No PDF viewer found"
            exec foot --app-id=neuxon-err --window-size-chars=70x12 -e sh -c "echo 'No document viewer installed. Run: sudo apt install zathura'; read -r _"
        fi
        ;;

    calc|calculator|galculator)
        if [ -x /usr/local/bin/neuxon-calc ]; then
            exec /usr/local/bin/neuxon-calc "$@"
        elif command -v galculator >/dev/null 2>&1; then
            exec galculator "$@"
        else
            exec foot --app-id=neuxon-calc --window-size-chars=44x16 -e python3 -q
        fi
        ;;

    notes|memo)
        exec foot --app-id=neuxon-notes --title="[ 05 // NEUXON VFS SCRATCHPAD & MEMO ]" -e /usr/local/bin/neuxon-notes-widget "$@"
        ;;

    disk|storage|ncdu)
        if command -v ncdu >/dev/null 2>&1; then
            exec foot --app-id=neuxon-ncdu --window-size-chars=100x30 -e ncdu /
        else
            exec foot --app-id=neuxon-ncdu --window-size-chars=80x24 -e sh -c "df -h; echo ''; exec sh"
        fi
        ;;

    mousepad)
        if command -v mousepad >/dev/null 2>&1; then
            exec mousepad "$@"
        else
            exec /usr/local/bin/neuxon-launch editor "$@"
        fi
        ;;

    fastfetch|sysinfo)
        if command -v fastfetch >/dev/null 2>&1; then
            exec foot --app-id=neuxon-fastfetch --window-size-chars=96x28 -e sh -c "fastfetch; echo ''; echo 'Press [Enter] to exit.'; read -r _"
        elif command -v neofetch >/dev/null 2>&1; then
            exec foot --app-id=neuxon-fastfetch --window-size-chars=96x28 -e sh -c "neofetch; echo ''; echo 'Press [Enter] to exit.'; read -r _"
        else
            log_heal "fastfetch missing, running kernel uname diagnostic"
            exec foot --app-id=neuxon-fastfetch --window-size-chars=96x28 -e sh -c "uname -a; lscpu; free -h; echo ''; echo 'Press [Enter] to exit.'; read -r _"
        fi
        ;;

    editor|edit|micro|hx)
        if command -v micro >/dev/null 2>&1; then
            exec foot --app-id=neuxon-editor --window-size-chars=104x32 -e micro "$@"
        elif command -v hx >/dev/null 2>&1; then
            exec foot --app-id=neuxon-editor --window-size-chars=104x32 -e hx "$@"
        elif command -v mousepad >/dev/null 2>&1; then
            exec mousepad "$@"
        elif command -v nano >/dev/null 2>&1; then
            exec foot --app-id=neuxon-editor --window-size-chars=104x32 -e nano "$@"
        else
            log_heal "micro/hx missing, falling back to vi"
            exec foot --app-id=neuxon-editor --window-size-chars=104x32 -e vi "$@"
        fi
        ;;

    control|neuxon-control)
        if [ -x /usr/local/bin/neuxon-control ]; then
            exec foot -a neuxon-control -T "Neuxon Control Center" /usr/local/bin/neuxon-control "$@"
        else
            log_heal "neuxon-control binary missing, launching power menu"
            exec foot --app-id=neuxon-control -e /usr/local/bin/neuxon-launch power
        fi
        ;;

    doctor|heal)
        exec foot --app-id=neuxon-heal --window-size-chars=88x24 -e sh -c "/usr/local/bin/neuxon-doctor; echo ''; echo 'Press [Enter] to close.'; read -r _"
        ;;

    power|exit)
        if [ -x /usr/local/bin/neuxon-power ]; then
            exec /usr/local/bin/neuxon-power "$@"
        else
            exec foot --app-id=neuxon-power --window-size-chars=60x14 -e sh -c "
                echo '╔════════════════════════════════════════════════════════╗'
                echo '║          NEUXON OS POWER MANAGEMENT                    ║'
                echo '╠════════════════════════════════════════════════════════╣'
                echo '║  [1] Power Off System                                  ║'
                echo '║  [2] Reboot System                                     ║'
                echo '║  [3] Exit Wayland Session                              ║'
                echo '║  [4] Cancel                                            ║'
                echo '╚════════════════════════════════════════════════════════╝'
                read -p 'Select option [1-4]: ' opt
                case \"\$opt\" in
                    1) sudo poweroff ;;
                    2) sudo reboot ;;
                    3) pkill labwc ;;
                    *) exit 0 ;;
                esac
            "
        fi
        ;;

    *)
        # Generic launcher with auto-terminal wrap for CLI tools
        if [ -z "${APP}" ]; then
            exec fuzzel
        fi

        if command -v "${APP}" >/dev/null 2>&1; then
            # Test if binary is graphical or TUI
            if ldd "$(command -v "${APP}")" 2>/dev/null | grep -qE "libwayland|libX11|libgtk|libQt"; then
                exec "${APP}" "$@"
            else
                exec foot --app-id="neuxon-${APP}" --window-size-chars=104x32 -e "${APP}" "$@"
            fi
        else
            log_heal "Command '${APP}' not found in PATH"
            exec foot --app-id="neuxon-err" --window-size-chars=70x12 -e sh -c "echo 'Command not found: ${APP}'; echo 'Press [Enter] to exit.'; read -r _"
        fi
        ;;
esac
