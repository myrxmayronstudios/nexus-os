[
    {
        "name": "top-bar",
        "layer": "top",
        "position": "top",
        "height": 32,
        "spacing": 4,
        "modules-left": [
            "custom/neuxon-brand",
            "wlr/workspaces"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "cpu",
            "memory",
            "temperature",
            "custom/zram",
            "network",
            "custom/volume",
            "tray"
        ],
        "custom/neuxon-brand": {
            "format": "❖ NEUXON",
            "tooltip-format": "Neuxon OS (Super+D for App Menu)",
            "on-click": "fuzzel"
        },
        "wlr/workspaces": {
            "disable-scroll": true,
            "all-outputs": true,
            "format": "{icon}",
            "format-icons": {
                "1": "◆",
                "2": "◇",
                "3": "◇",
                "4": "◇",
                "active": "◆",
                "default": "◇"
            },
            "on-click": "activate"
        },
        "clock": {
            "format": "{:%H:%M:%S  ·  %Y-%m-%d}",
            "tooltip-format": "<tt><small>{calendar}</small></tt>",
            "interval": 1
        },
        "cpu": {
            "format": "CPU {usage}%",
            "interval": 2,
            "tooltip": true,
            "on-click": "/usr/local/bin/neuxon-launch btop"
        },
        "memory": {
            "format": "RAM {percentage}%",
            "interval": 3,
            "tooltip-format": "RAM: {used:0.2f}GB / {total:0.2f}GB ({percentage}%)",
            "on-click": "/usr/local/bin/neuxon-launch btop"
        },
        "temperature": {
            "thermal-zone": 0,
            "format": "{temperatureC}°C",
            "critical-threshold": 75,
            "format-critical": "! {temperatureC}°C",
            "interval": 4,
            "tooltip-format": "BCM2837B0 Core Temp: {temperatureC}°C"
        },
        "custom/zram": {
            "exec": "/usr/local/bin/neuxon-zram-status",
            "interval": 5,
            "tooltip-format": "ZRAM Memory Compression Ratio",
            "on-click": "/usr/local/bin/neuxon-launch btop"
        },
        "network": {
            "interval": 5,
            "format-wifi": "WLAN {signalStrength}%",
            "format-ethernet": "ETH {ifname}",
            "format-disconnected": "OFFLINE",
            "tooltip-format-wifi": "SSID: {essid} | IP: {ipaddr} | Signal: {signalStrength}%",
            "tooltip-format-ethernet": "Interface: {ifname} | IP: {ipaddr}",
            "on-click": "/usr/local/bin/neuxon-launch control"
        },
        "custom/volume": {
            "exec": "/usr/local/bin/neuxon-volume-status",
            "interval": 2,
            "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
            "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
            "tooltip-format": "WirePlumber Audio Volume"
        },
        "tray": {
            "icon-size": 13,
            "spacing": 6
        }
    },
    {
        "name": "dock",
        "layer": "top",
        "position": "bottom",
        "height": 48,
        "margin-bottom": 12,
        "spacing": 8,
        "modules-center": [
            "custom/dock-browser",
            "custom/dock-term",
            "custom/dock-btop",
            "custom/dock-files",
            "custom/dock-fastfetch",
            "custom/dock-heal",
            "custom/dock-power"
        ],
        "custom/dock-browser": {
            "format": "🌐 Chromium",
            "tooltip-format": "Chromium Web Browser (ARM64 Optimized)",
            "on-click": "/usr/local/bin/neuxon-launch chromium"
        },
        "custom/dock-term": {
            "format": ">_ Terminal",
            "tooltip-format": "Foot Terminal Shell (Super+Return)",
            "on-click": "/usr/local/bin/neuxon-launch foot"
        },
        "custom/dock-btop": {
            "format": "📊 btop",
            "tooltip-format": "BTOP System Monitor & Task Matrix",
            "on-click": "/usr/local/bin/neuxon-launch btop"
        },
        "custom/dock-files": {
            "format": "📁 Files",
            "tooltip-format": "Yazi Terminal File Manager",
            "on-click": "/usr/local/bin/neuxon-launch yazi"
        },
        "custom/dock-fastfetch": {
            "format": "⚡ Fastfetch",
            "tooltip-format": "Neuxon Architecture & Kernel Specification",
            "on-click": "/usr/local/bin/neuxon-launch fastfetch"
        },
        "custom/dock-heal": {
            "format": "🛠 Heal OS",
            "tooltip-format": "Neuxon Autonomous Self-Healing Diagnostic",
            "on-click": "/usr/local/bin/neuxon-launch doctor"
        },
        "custom/dock-power": {
            "format": "⏻ Power",
            "tooltip-format": "Neuxon Power & Control Center",
            "on-click": "/usr/local/bin/neuxon-launch control"
        }
    }
]
