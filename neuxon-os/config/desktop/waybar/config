{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 6,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "custom/launcher",
        "wlr/workspaces",
        "custom/hud"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "custom/zram",
        "memory",
        "temperature",
        "network",
        "custom/volume",
        "tray"
    ],

    "custom/launcher": {
        "format": "◆ NEUXON // OS",
        "tooltip-format": "Neuxon Application Launcher (Super+D)",
        "on-click": "fuzzel"
    },

    "custom/hud": {
        "format": "◇ HUD",
        "tooltip-format": "Toggle Neuxon System HUD Overlay (Super+H)",
        "on-click": "/usr/local/bin/neuxon-hud"
    },

    "wlr/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "◆",
            "2": "◇",
            "3": "◇",
            "4": "◇",
            "active": "◆",
            "default": "◇"
        },
        "on-click": "activate"
    },

    "clock": {
        "format": "{:%H:%M:%S  ·  %Y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "interval": 1
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,
        "tooltip": true,
        "on-click": "foot -e btop"
    },

    "custom/zram": {
        "exec": "bash -c 'if command -v zramctl &>/dev/null; then r=$(zramctl --bytes 2>/dev/null | awk \"NR>1 {if (\\$4>0) printf \\\"%.1fx\\\", \\$3/\\$4; else print \\\"1.0x\\\"}\"); echo \"ZRAM ${r:-1.0x}\"; else echo \"ZRAM OK\"; fi'",
        "interval": 5,
        "tooltip-format": "ZRAM Memory Compression Ratio",
        "on-click": "foot -e btop"
    },

    "memory": {
        "format": "RAM {percentage}%",
        "interval": 3,
        "tooltip-format": "RAM: {used:0.2f}GB / {total:0.2f}GB ({percentage}%)",
        "on-click": "foot -e btop"
    },

    "temperature": {
        "thermal-zone": 0,
        "format": "{temperatureC}°C",
        "critical-threshold": 75,
        "format-critical": "! {temperatureC}°C",
        "interval": 4,
        "tooltip-format": "BCM2837B0 Core Temp: {temperatureC}°C"
    },

    "network": {
        "interval": 5,
        "format-wifi": "WLAN {signalStrength}%",
        "format-ethernet": "ETH {ifname}",
        "format-disconnected": "OFFLINE",
        "tooltip-format-wifi": "SSID: {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}",
        "on-click": "foot -a neuxon-control /usr/local/bin/neuxon-control"
    },

    "custom/volume": {
        "exec": "bash -c 'if command -v wpctl &>/dev/null; then v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk \"{print int(\\$2*100)}\"); echo \"VOL ${v:-50}%\"; else echo \"VOL 50%\"; fi'",
        "interval": 2,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "tooltip-format": "WirePlumber Audio Volume"
    },

    "tray": {
        "icon-size": 13,
        "spacing": 6
    }
}
