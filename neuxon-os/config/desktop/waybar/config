[
    {
        "name": "top-bar",
        "layer": "top",
        "position": "top",
        "height": 24,
        "spacing": 4,
        "modules-left": [
            "custom/apple",
            "wlr/workspaces"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "cpu",
            "custom/zram",
            "memory",
            "temperature",
            "network",
            "custom/volume",
            "tray"
        ],
        "custom/apple": {
            "format": "\u2756 NEUXON",
            "tooltip-format": "Neuxon OS 2.0 (Super+D for App Launcher)",
            "on-click": "fuzzel"
        },
        "wlr/workspaces": {
            "disable-scroll": true,
            "all-outputs": true,
            "format": "{icon}",
            "format-icons": {
                "1": "\u25c6",
                "2": "\u25c7",
                "3": "\u25c7",
                "4": "\u25c7",
                "active": "\u25c6",
                "default": "\u25c7"
            },
            "on-click": "activate"
        },
        "clock": {
            "format": "{:%H:%M:%S  \u00b7  %Y-%m-%d}",
            "tooltip-format": "<tt><small>{calendar}</small></tt>",
            "interval": 1
        },
        "cpu": {
            "format": "CPU {usage}%",
            "interval": 2,
            "tooltip": true,
            "on-click": "/usr/local/bin/neuxon-btop-gadget"
        },
        "custom/zram": {
            "exec": "/usr/local/bin/neuxon-zram-status",
            "interval": 5,
            "tooltip-format": "ZRAM Memory Compression Ratio",
            "on-click": "/usr/local/bin/neuxon-btop-gadget"
        },
        "memory": {
            "format": "RAM {percentage}%",
            "interval": 3,
            "tooltip-format": "RAM: {used:0.2f}GB / {total:0.2f}GB ({percentage}%)",
            "on-click": "/usr/local/bin/neuxon-btop-gadget"
        },
        "temperature": {
            "thermal-zone": 0,
            "format": "{temperatureC}\u00b0C",
            "critical-threshold": 75,
            "format-critical": "! {temperatureC}\u00b0C",
            "interval": 4,
            "tooltip-format": "BCM2837B0 Core Temp: {temperatureC}\u00b0C"
        },
        "network": {
            "interval": 5,
            "format-wifi": "WLAN {signalStrength}%",
            "format-ethernet": "ETH {ifname}",
            "format-disconnected": "OFFLINE",
            "tooltip-format-wifi": "SSID: {essid} | IP: {ipaddr} | Strength: {signalStrength}%",
            "tooltip-format-ethernet": "Interface: {ifname} | IP: {ipaddr}",
            "on-click": "foot -a neuxon-control /usr/local/bin/neuxon-control"
        },
        "custom/volume": {
            "exec": "/usr/local/bin/neuxon-volume-status",
            "interval": 2,
            "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
            "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
            "tooltip-format": "WirePlumber Audio Volume"
        },
        "tray": {
            "icon-size": 13,
            "spacing": 6
        }
    },
    {
        "name": "dock",
        "layer": "top",
        "position": "bottom",
        "height": 44,
        "margin-bottom": 10,
        "spacing": 6,
        "modules-center": [
            "custom/dock-launcher",
            "custom/dock-browser",
            "custom/dock-term",
            "custom/dock-files",
            "custom/dock-editor",
            "custom/dock-btop",
            "custom/dock-control",
            "custom/dock-hud",
            "custom/dock-trash"
        ],
        "custom/dock-launcher": {
            "format": "\u2756 APPS",
            "tooltip-format": "Application Menu (Super+D)",
            "on-click": "fuzzel"
        },
        "custom/dock-browser": {
            "format": "\ud83c\udf10 WEB",
            "tooltip-format": "Chromium Web Browser",
            "on-click": "/usr/local/bin/neuxon-browser"
        },
        "custom/dock-term": {
            "format": ">_ TERM",
            "tooltip-format": "Foot Terminal Shell (Super+Return)",
            "on-click": "foot"
        },
        "custom/dock-files": {
            "format": "\ud83d\udcc1 FILES",
            "tooltip-format": "Yazi File Manager",
            "on-click": "foot -e yazi"
        },
        "custom/dock-editor": {
            "format": "\ud83d\udcdd EDIT",
            "tooltip-format": "Micro Code & Text Editor",
            "on-click": "foot -e micro"
        },
        "custom/dock-btop": {
            "format": "\ud83d\udcca MON",
            "tooltip-format": "Toggle Desktop btop Gadget (Super+B)",
            "on-click": "/usr/local/bin/neuxon-btop-gadget"
        },
        "custom/dock-control": {
            "format": "\u2699 CTRL",
            "tooltip-format": "Neuxon Control Center (Super+C)",
            "on-click": "foot -a neuxon-control -T 'Neuxon Control Center' /usr/local/bin/neuxon-control"
        },
        "custom/dock-hud": {
            "format": "\u25c7 HUD",
            "tooltip-format": "Toggle Neuxon HUD Overlay (Super+H)",
            "on-click": "/usr/local/bin/neuxon-hud"
        },
        "custom/dock-trash": {
            "format": "\ud83d\uddd1 TRASH",
            "tooltip-format": "Trash (Open Trash directory)",
            "on-click": "foot -e yazi ~/.local/share/Trash"
        }
    }
]
