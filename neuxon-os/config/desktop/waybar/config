{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": [
        "custom/logo",
        "wlr/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "network",
        "pulseaudio",
        "battery",
        "tray"
    ],

    "custom/logo": {
        "format": "NEUXON",
        "tooltip": false,
        "on-click": "fuzzel"
    },

    "wlr/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "active-only": false,
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": []
        }
    },

    "clock": {
        "format": "{:%H:%M  %Y-%m-%d}",
        "tooltip-format": "{:%A, %B %d, %Y  %H:%M:%S}",
        "interval": 60
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 5,
        "tooltip": true,
        "on-click": "foot -e btop"
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 5,
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G ({percentage}%)\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
        "on-click": "foot -e btop"
    },

    "temperature": {
        "thermal-zone": 0,
        "format": " {temperatureC}°C",
        "critical-threshold": 75,
        "format-critical": " {temperatureC}°C",
        "interval": 10,
        "tooltip-format": "CPU Temperature: {temperatureC}°C"
    },

    "network": {
        "interval": 10,
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " {ifname}",
        "format-disconnected": "󰖪 ",
        "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}/{cidr}\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "foot -e nmtui"
    },

    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": " muted",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
        "tooltip-format": "Volume: {volume}%\nOutput: {desc}"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-not-found": "",
        "tooltip-format": "Battery: {capacity}%\nStatus: {status}\nTime: {time}"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 0,
        "show-passive-items": true
    }
}
