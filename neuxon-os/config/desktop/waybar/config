[
    {
        "name": "top-bar",
        "layer": "top",
        "position": "top",
        "height": 30,
        "exclusive": true,
        "passthrough": false,
        "spacing": 4,
        "modules-left": [
            "custom/neuxon-brand",
            "custom/ws1",
            "custom/ws2",
            "custom/ws3",
            "custom/ws4"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "cpu",
            "temperature",
            "memory",
            "network"
        ],
        "custom/neuxon-brand": {
            "format": "❖ NEUXON",
            "tooltip-format": "Neuxon OS (Super+D for App Menu)",
            "on-click": "fuzzel"
        },
        "custom/ws1": {
            "format": "[1]",
            "tooltip-format": "Switch to Workspace 1 (Super+1)",
            "on-click": "wtype -M logo -k 1 -m logo 2>/dev/null || true"
        },
        "custom/ws2": {
            "format": "[2]",
            "tooltip-format": "Switch to Workspace 2 (Super+2)",
            "on-click": "wtype -M logo -k 2 -m logo 2>/dev/null || true"
        },
        "custom/ws3": {
            "format": "[3]",
            "tooltip-format": "Switch to Workspace 3 (Super+3)",
            "on-click": "wtype -M logo -k 3 -m logo 2>/dev/null || true"
        },
        "custom/ws4": {
            "format": "[4]",
            "tooltip-format": "Switch to Workspace 4 (Super+4)",
            "on-click": "wtype -M logo -k 4 -m logo 2>/dev/null || true"
        },
        "clock": {
            "format": "[ {:%a %b %d  ·  %H:%M:%S} ]",
            "tooltip-format": "<tt><small>{calendar}</small></tt>",
            "interval": 1
        },
        "cpu": {
            "format": "[ CPU {usage:2}% ]",
            "interval": 2,
            "tooltip": true,
            "on-click": "/usr/local/bin/btop"
        },
        "temperature": {
            "thermal-zone": 0,
            "format": "[ TEMP {temperatureC}°C ]",
            "critical-threshold": 75,
            "format-critical": "[ ! TEMP {temperatureC}°C ]",
            "interval": 4,
            "tooltip-format": "BCM2837B0 Core Temp: {temperatureC}°C"
        },
        "memory": {
            "format": "[ RAM {used:0.0f}M ]",
            "interval": 3,
            "tooltip-format": "RAM: {used:0.2f}GB / {total:0.2f}GB ({percentage}%)",
            "on-click": "/usr/local/bin/btop"
        },
        "network": {
            "interval": 5,
            "format-wifi": "[ NET {signalStrength}% ]",
            "format-ethernet": "[ NET UP ]",
            "format-disconnected": "[ NET DOWN ]",
            "tooltip-format-wifi": "SSID: {essid} | IP: {ipaddr} | Signal: {signalStrength}%",
            "tooltip-format-ethernet": "Interface: {ifname} | IP: {ipaddr}",
            "on-click": "/usr/local/bin/neuxon-launch control"
        }
    },
    {
        "name": "dock",
        "layer": "top",
        "position": "bottom",
        "height": 46,
        "margin-bottom": 12,
        "exclusive": true,
        "passthrough": false,
        "spacing": 8,
        "modules-center": [
            "custom/dock-browser",
            "custom/dock-term",
            "custom/dock-calc",
            "custom/dock-files",
            "custom/dock-notes",
            "custom/dock-heal",
            "custom/dock-power"
        ],
        "custom/dock-browser": {
            "format": "🌐 Browser",
            "tooltip-format": "Chromium Web Browser (ARM64 Optimized)",
            "on-click": "/usr/local/bin/neuxon-launch browser"
        },
        "custom/dock-term": {
            "format": ">_ Terminal",
            "tooltip-format": "Foot Terminal Shell (Super+Return)",
            "on-click": "/usr/local/bin/neuxon-launch terminal"
        },
        "custom/dock-calc": {
            "format": "🖩 Calc",
            "tooltip-format": "Neuxon Scientific & Programmer Calculator",
            "on-click": "/usr/local/bin/neuxon-calc"
        },
        "custom/dock-files": {
            "format": "📁 Files",
            "tooltip-format": "Neuxon File Manager (Yazi / PCManFM)",
            "on-click": "/usr/local/bin/neuxon-launch files"
        },
        "custom/dock-notes": {
            "format": "📝 Notes",
            "tooltip-format": "Persistent VFS Notes Scratchpad",
            "on-click": "/usr/local/bin/neuxon-launch notes"
        },
        "custom/dock-heal": {
            "format": "🛠 Heal",
            "tooltip-format": "Neuxon Autonomous Self-Healing Diagnostic",
            "on-click": "/usr/local/bin/neuxon-launch doctor"
        },
        "custom/dock-power": {
            "format": "⏻ Power",
            "tooltip-format": "Neuxon Power Management",
            "on-click": "/usr/local/bin/neuxon-power"
        }
    }
]
