#!/usr/bin/env bash
# ============================================================================
# Neuxon OS v5.0 - Chromium Web Browser Launcher
# Hardware-tuned for Raspberry Pi 3B+ (1GB LPDDR2, vc4-kms-v3d Wayland)
# ============================================================================
set -u

STARTPAGE="${HOME}/.local/share/neuxon/startpage.html"
if [ ! -f "$STARTPAGE" ]; then
    mkdir -p "${HOME}/.local/share/neuxon"
    if [ -f /usr/local/share/neuxon/startpage.html ]; then
        cp /usr/local/share/neuxon/startpage.html "$STARTPAGE"
    fi
fi

URL="${1:-file://${STARTPAGE}}"
shift || true

# RPi3B+ Wayland flags
CHROMIUM_FLAGS=(
    --ozone-platform=wayland
    --enable-features=UseOzonePlatform
    --no-sandbox
    --test-type
    --disable-dev-shm-usage
    --disable-background-networking
    --process-per-site
    --force-dark-mode
    --enable-smooth-scrolling
    --password-store=basic
)

for bin in chromium-browser chromium google-chrome; do
    if command -v "$bin" >/dev/null 2>&1; then
        exec "$bin" "${CHROMIUM_FLAGS[@]}" "$URL" "$@"
    fi
done

# Fallback: text browser inside foot
if command -v w3m >/dev/null 2>&1; then
    exec foot --app-id=neuxon-browser -e w3m "$URL"
else
    echo "No browser installed. Run: sudo apt install chromium"
    read -r _
fi
