# ============================================================================
# Neuxon OS - btop Dark Monochrome Theme
# Pure Grayscale / High Contrast Monochrome
# ============================================================================

# Main background, empty for terminal default, or hex code
theme[main_bg]="#080808"

# Main text color
theme[main_fg]="#F2F2F2"

# Title color for boxes
theme[title]="#FFFFFF"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#FFFFFF"

# Background color of selected item
theme[selected_bg]="#FFFFFF"

# Foreground color of selected item
theme[selected_fg]="#000000"

# Color of inactive/disabled text
theme[inactive_fg]="#555555"

# Color of text appearing on top of graphs, i.e. uptime and current process
theme[graph_text]="#888888"

# Background color of the percentage meters
theme[meter_bg]="#121212"

# Misc colors for processes box including mini cpu graphs, details and status
theme[proc_misc]="#888888"

# Cpu box outline color
theme[cpu_box]="#262626"

# Memory/disks box outline color
theme[mem_box]="#262626"

# Net box outline color
theme[net_box]="#262626"

# Processes box outline color
theme[proc_box]="#262626"

# Box divider line and small symbols
theme[div_line]="#262626"

# Temperature graph colors (cool to hot)
theme[temp_start]="#666666"
theme[temp_mid]="#AAAAAA"
theme[temp_end]="#FFFFFF"

# CPU graph colors
theme[cpu_start]="#666666"
theme[cpu_mid]="#AAAAAA"
theme[cpu_end]="#FFFFFF"

# Mem colors
theme[free_start]="#444444"
theme[free_mid]="#666666"
theme[free_end]="#888888"

theme[cached_start]="#666666"
theme[cached_mid]="#888888"
theme[cached_end]="#AAAAAA"

theme[available_start]="#888888"
theme[available_mid]="#BBBBBB"
theme[available_end]="#DDDDDD"

theme[used_start]="#AAAAAA"
theme[used_mid]="#DDDDDD"
theme[used_end]="#FFFFFF"

# Download graph colors
theme[download_start]="#666666"
theme[download_mid]="#AAAAAA"
theme[download_end]="#FFFFFF"

# Upload graph colors
theme[upload_start]="#666666"
theme[upload_mid]="#AAAAAA"
theme[upload_end]="#FFFFFF"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#666666"
theme[process_mid]="#AAAAAA"
theme[process_end]="#FFFFFF"
