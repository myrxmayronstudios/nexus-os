#!/usr/bin/env bash
# ============================================================================
# Neuxon OS - Persistent VFS Notes & Checklist Widget (436x560 px)
# Backed directly by ~/.local/share/neuxon/notes.txt with live auto-save
# ============================================================================
set -u

NOTES_DIR="${HOME}/.local/share/neuxon"
NOTES_FILE="${NOTES_DIR}/notes.txt"
mkdir -p "${NOTES_DIR}"

if [ ! -f "${NOTES_FILE}" ]; then
    cat > "${NOTES_FILE}" << 'EOF'
=== NEUXON OS // SYSTEM CHECKLIST & NOTES ===
[OK] BCM2837B0 ARM64 Kernel 64-bit Verified
[OK] 16-Bit Obsidian & Silver Compositor Active
[OK] VideoCore IV vc4-kms-v3d Acceleration Ready
[OK] ZRAM zstd Swap Configured (1GB Pool)

WORKSPACE SHORTCUTS:
• Super + Return : Foot Terminal
• Super + D      : Fuzzel Application Launcher
• Super + B      : Focus btop System Monitor
• Super + C      : Neuxon Control Center
• Super + P      : Power Management Dialog
• Super + Q      : Close Focused Window
• Super + 1..4   : Switch Workspaces

PERSISTENT SCRATCHPAD:
- Click anywhere with your mouse to focus cursor
- Edits auto-save immediately to notes.txt
EOF
fi

# Ensure user micro settings exist with mouse and autosave enabled
USER_MICRO_DIR="${HOME}/.config/micro"
mkdir -p "${USER_MICRO_DIR}"
if [ ! -f "${USER_MICRO_DIR}/settings.json" ]; then
    cat > "${USER_MICRO_DIR}/settings.json" << 'EOF'
{
    "colorscheme": "simple",
    "cursorline": true,
    "mouse": true,
    "autosave": 1,
    "scrollbar": false,
    "statusline": true
}
EOF
fi

clear
while true; do
    if command -v micro >/dev/null 2>&1; then
        micro "${NOTES_FILE}"
    elif command -v nano >/dev/null 2>&1; then
        nano -m "${NOTES_FILE}"
    elif command -v hx >/dev/null 2>&1; then
        hx "${NOTES_FILE}"
    else
        vi "${NOTES_FILE}" || sleep 2
    fi
    sleep 0.5
done
