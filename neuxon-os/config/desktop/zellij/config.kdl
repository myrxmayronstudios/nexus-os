// ============================================================================
// Neuxon OS - Stealth Monochrome Zellij Configuration
// ============================================================================

theme "neuxon-monochrome"
default_layout "compact"
simplified_ui true
pane_frames true
mouse_mode true
copy_on_select true

themes {
    neuxon-monochrome {
        fg "#F5F5F5"
        bg "#050505"
        black "#050505"
        red "#7A7A7A"
        green "#A0A0A0"
        yellow "#C2C2C2"
        blue "#D4D4D4"
        magenta "#E0E0E0"
        cyan "#F5F5F5"
        white "#FFFFFF"
        orange "#B0B0B0"
    }
}

ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}
