<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>

  <core>
    <gap>4</gap>
    <adaptiveSync>no</adaptiveSync>
    <reuseOutputMode>no</reuseOutputMode>
  </core>

  <theme>
    <name>Neuxon-Monochrome</name>
    <cornerRadius>6</cornerRadius>
    <font place="ActiveWindow">
      <name>JetBrains Mono Nerd Font, JetBrains Mono, monospace</name>
      <size>10</size>
      <slant>normal</slant>
      <weight>bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>JetBrains Mono Nerd Font, JetBrains Mono, monospace</name>
      <size>10</size>
      <slant>normal</slant>
      <weight>normal</weight>
    </font>
    <font place="MenuItem">
      <name>JetBrains Mono Nerd Font, JetBrains Mono, monospace</name>
      <size>10</size>
      <slant>normal</slant>
      <weight>normal</weight>
    </font>
    <font place="OnScreenDisplay">
      <name>JetBrains Mono Nerd Font, JetBrains Mono, monospace</name>
      <size>10</size>
      <slant>normal</slant>
      <weight>bold</weight>
    </font>
  </theme>

  <decoration>
    <titlebar>
      <height>24</height>
    </titlebar>
    <border>
      <width>1</width>
    </border>
  </decoration>

  <windowRules>
    <windowRule identifier="*" type="*">
      <serverDecoration>yes</serverDecoration>
      <skipTaskbar>no</skipTaskbar>
    </windowRule>

    <!-- Always-running btop desktop gadget rule -->
    <windowRule identifier="btop-gadget">
      <windowType>normal</windowType>
      <serverDecoration>no</serverDecoration>
      <skipTaskbar>yes</skipTaskbar>
      <skipWindowSwitcher>yes</skipWindowSwitcher>
      <ignoreFocusRequest>yes</ignoreFocusRequest>
      <action name="ToggleAlwaysOnBottom" />
      <action name="ToggleOmnipresent" />
      <action name="MoveTo" x="16" y="46" />
    </windowRule>

    <!-- Floating HUD window rule -->
    <windowRule identifier="neuxon-hud">
      <windowType>normal</windowType>
      <serverDecoration>no</serverDecoration>
      <action name="ToggleAlwaysOnTop" />
    </windowRule>
  </windowRules>

  <focus>
    <followMouse>yes</followMouse>
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <snapping>
    <range>4</range>
    <topMaximize>yes</topMaximize>
    <notifyClient>always</notifyClient>
  </snapping>

  <desktops number="4">
    <popupTime>0</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <resize>
    <popupShow>Never</popupShow>
  </resize>

  <keyboard>
    <default />

    <!-- Terminal -->
    <keybind key="Super_L-Return">
      <action name="Execute">
        <command>foot</command>
      </action>
    </keybind>

    <!-- App Launcher -->
    <keybind key="Super_L-d">
      <action name="Execute">
        <command>fuzzel</command>
      </action>
    </keybind>

    <!-- Toggle btop desktop gadget -->
    <keybind key="Super_L-b">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-btop-gadget</command>
      </action>
    </keybind>

    <!-- Neuxon Control Center -->
    <keybind key="Super_L-c">
      <action name="Execute">
        <command>foot -a neuxon-control -T "Neuxon Control Center" /usr/local/bin/neuxon-control</command>
      </action>
    </keybind>

    <!-- Neuxon System HUD -->
    <keybind key="Super_L-h">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-hud</command>
      </action>
    </keybind>

    <!-- Lockscreen -->
    <keybind key="Super_L-l">
      <action name="Execute">
        <command>swaylock -f -c 050505 --ring-color FFFFFF --inside-color 0E0E0E --line-color 2A2A2A --text-color F5F5F5</command>
      </action>
    </keybind>

    <!-- Close window -->
    <keybind key="Super_L-q">
      <action name="Close" />
    </keybind>

    <!-- Toggle fullscreen -->
    <keybind key="Super_L-f">
      <action name="ToggleFullscreen" />
    </keybind>

    <!-- Window Navigation / Tiling Snap -->
    <keybind key="Super_L-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="Super_L-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="Super_L-Up">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="Super_L-Down">
      <action name="Iconify" />
    </keybind>

    <!-- Workspace switching -->
    <keybind key="Super_L-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="Super_L-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="Super_L-3">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="Super_L-4">
      <action name="GoToDesktop" to="4" />
    </keybind>

    <!-- Send to workspace -->
    <keybind key="Super_L-Shift-1">
      <action name="SendToDesktop" to="1" />
    </keybind>
    <keybind key="Super_L-Shift-2">
      <action name="SendToDesktop" to="2" />
    </keybind>
    <keybind key="Super_L-Shift-3">
      <action name="SendToDesktop" to="3" />
    </keybind>
    <keybind key="Super_L-Shift-4">
      <action name="SendToDesktop" to="4" />
    </keybind>

    <!-- Screenshot -->
    <keybind key="Print">
      <action name="Execute">
        <command>sh -c "grim ~/Pictures/screenshot_$(date +%Y%m%d_%H%M%S).png &amp;&amp; notify-send 'Screenshot captured'"</command>
      </action>
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <context name="Frame">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="TitleBar">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu">
          <menu>root-menu</menu>
        </action>
      </mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="default">
      <naturalScroll>no</naturalScroll>
      <tap>yes</tap>
      <tapButtonMap>lrm</tapButtonMap>
      <pointerSpeed>0.0</pointerSpeed>
      <accelProfile>adaptive</accelProfile>
    </device>
  </libinput>

</labwc_config>
