<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>4</gap>
    <adaptiveSync>no</adaptiveSync>
    <reuseOutputMode>no</reuseOutputMode>
  </core>

  <theme>
    <name>Clearlooks-3.4</name>
    <cornerRadius>0</cornerRadius>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <font place="ActiveWindow"><name>JetBrains Mono</name><size>10</size><slant>normal</slant><weight>bold</weight></font>
    <font place="InactiveWindow"><name>JetBrains Mono</name><size>10</size><slant>normal</slant><weight>normal</weight></font>
    <font place="MenuHeader"><name>JetBrains Mono</name><size>10</size><slant>normal</slant><weight>bold</weight></font>
    <font place="MenuItem"><name>JetBrains Mono</name><size>10</size><slant>normal</slant><weight>normal</weight></font>
    <font place="OnScreenDisplay"><name>JetBrains Mono</name><size>11</size><slant>normal</slant><weight>bold</weight></font>
  </theme>

  <windowRules>
    <windowRule identifier="*" serverDecoration="yes" skipTaskbar="no" />

    <!-- Terminal Widget 1: Sysinfo (Top-Left) - Fixed & Unmovable -->
    <windowRule identifier="neuxon-sysinfo" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" fixedPosition="yes" ignoreFocusRequest="yes">
      <action name="MoveTo" x="24" y="44" />
      <action name="ResizeTo" width="520" height="250" />
    </windowRule>

    <!-- Terminal Widget 2: btop System Monitor (Top-Center) - Fixed & Unmovable (Focus allowed) -->
    <windowRule identifier="neuxon-btop" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" fixedPosition="yes" ignoreFocusRequest="no">
      <action name="MoveTo" x="564" y="44" />
      <action name="ResizeTo" width="880" height="560" />
    </windowRule>

    <!-- Terminal Widget 3: Hardware Telemetry (Middle-Left) - Fixed & Unmovable -->
    <windowRule identifier="neuxon-telemetry" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" fixedPosition="yes" ignoreFocusRequest="yes">
      <action name="MoveTo" x="24" y="310" />
      <action name="ResizeTo" width="520" height="294" />
    </windowRule>

    <!-- Terminal Widget 4: Chrono & Network Matrix (Bottom-Left) - Fixed & Unmovable -->
    <windowRule identifier="neuxon-net" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" fixedPosition="yes" ignoreFocusRequest="yes">
      <action name="MoveTo" x="24" y="620" />
      <action name="ResizeTo" width="520" height="250" />
    </windowRule>

    <!-- Terminal Widget 5: VFS Notes & Checklist (Top-Right) - Fixed & Unmovable -->
    <windowRule identifier="neuxon-notes" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" fixedPosition="yes" ignoreFocusRequest="no">
      <action name="MoveTo" x="1460" y="44" />
      <action name="ResizeTo" width="436" height="560" />
    </windowRule>

    <!-- Terminal Widget 6: Kernel Ring & IPC Matrix (Bottom-Right) - Fixed & Unmovable -->
    <windowRule identifier="neuxon-matrix" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" fixedPosition="yes" ignoreFocusRequest="yes">
      <action name="MoveTo" x="564" y="620" />
      <action name="ResizeTo" width="1332" height="250" />
    </windowRule>

    <!-- Catch-all for any additional Neuxon desktop widgets -->
    <windowRule identifier="neuxon-*-widget" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" fixedPosition="yes" />

    <!-- Secondary HUD & App Dialog Rules -->
    <windowRule identifier="neuxon-hud" serverDecoration="no">
      <action name="ToggleAlwaysOnTop" />
    </windowRule>

    <windowRule identifier="neuxon-control" serverDecoration="yes">
      <action name="MoveTo" x="360" y="160" />
      <action name="ResizeTo" width="1200" height="700" />
    </windowRule>

    <!-- Neuxon Calculator Window Rule -->
    <windowRule identifier="neuxon-calc" serverDecoration="yes">
      <action name="MoveTo" x="780" y="240" />
      <action name="ResizeTo" width="380" height="540" />
    </windowRule>

    <!-- Neuxon Power Management Dialog Rule -->
    <windowRule identifier="neuxon-power" serverDecoration="yes">
      <action name="MoveTo" x="720" y="320" />
      <action name="ResizeTo" width="480" height="420" />
    </windowRule>

    <!-- Optimized Application Placement Rules -->
    <windowRule identifier="neuxon-files" serverDecoration="yes">
      <action name="MoveTo" x="420" y="180" />
      <action name="ResizeTo" width="1080" height="720" />
    </windowRule>

    <windowRule identifier="neuxon-music" serverDecoration="yes">
      <action name="MoveTo" x="480" y="240" />
      <action name="ResizeTo" width="960" height="600" />
    </windowRule>

    <windowRule identifier="cmus" serverDecoration="yes">
      <action name="MoveTo" x="480" y="240" />
      <action name="ResizeTo" width="960" height="600" />
    </windowRule>

    <windowRule identifier="imv" serverDecoration="yes">
      <action name="MoveTo" x="380" y="140" />
      <action name="ResizeTo" width="1160" height="780" />
    </windowRule>

    <windowRule identifier="org.pwmt.zathura" serverDecoration="yes">
      <action name="MoveTo" x="380" y="120" />
      <action name="ResizeTo" width="1160" height="820" />
    </windowRule>

    <windowRule identifier="galculator" serverDecoration="yes">
      <action name="MoveTo" x="780" y="240" />
      <action name="ResizeTo" width="380" height="540" />
    </windowRule>

    <windowRule identifier="pcmanfm" serverDecoration="yes">
      <action name="MoveTo" x="420" y="180" />
      <action name="ResizeTo" width="1080" height="720" />
    </windowRule>

    <windowRule identifier="mousepad" serverDecoration="yes">
      <action name="MoveTo" x="460" y="200" />
      <action name="ResizeTo" width="1000" height="680" />
    </windowRule>
  </windowRules>

  <focus>
    <followMouse>yes</followMouse>
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <snapping>
    <range>4</range>
    <topMaximize>yes</topMaximize>
    <notifyClient>always</notifyClient>
  </snapping>

  <desktops number="4">
    <popupTime>0</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <resize>
    <popupShow>Never</popupShow>
  </resize>

  <keyboard>
    <default />

    <!-- Core Terminal Shell -->
    <keybind key="W-Return">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch terminal</command>
      </action>
    </keybind>

    <!-- Application Launcher -->
    <keybind key="W-d">
      <action name="Execute">
        <command>fuzzel</command>
      </action>
    </keybind>

    <!-- Toggle / Focus btop Desktop Monitor (Single Instance Enforced) -->
    <keybind key="W-b">
      <action name="Execute">
        <command>/usr/local/bin/btop</command>
      </action>
    </keybind>

    <!-- Neuxon Control Center -->
    <keybind key="W-c">
      <action name="Execute">
        <command>foot -a neuxon-control -T "Neuxon Control Center" /usr/local/bin/neuxon-control</command>
      </action>
    </keybind>

    <!-- Neuxon Power Management Dialog -->
    <keybind key="W-p">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-power</command>
      </action>
    </keybind>

    <!-- Neuxon HUD Overlay -->
    <keybind key="W-h">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-hud</command>
      </action>
    </keybind>

    <!-- Screen Lock -->
    <keybind key="W-l">
      <action name="Execute">
        <command>swaylock -f -c 050505 --ring-color FFFFFF --inside-color 0E0E0E --line-color 2A2A2A --text-color F5F5F5</command>
      </action>
    </keybind>

    <!-- Close Window -->
    <keybind key="W-q">
      <action name="Close" />
    </keybind>

    <!-- Fullscreen Toggle -->
    <keybind key="W-f">
      <action name="ToggleFullscreen" />
    </keybind>

    <!-- Window Navigation / Tiling Snap -->
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="Iconify" />
    </keybind>

    <!-- Window Cycling -->
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>

    <!-- Workspace Navigation (W-1 .. W-4) -->
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4" />
    </keybind>

    <!-- Send Window to Workspace (W-S-1 .. W-S-4) -->
    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1" follow="yes" />
    </keybind>
    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2" follow="yes" />
    </keybind>
    <keybind key="W-S-3">
      <action name="SendToDesktop" to="3" follow="yes" />
    </keybind>
    <keybind key="W-S-4">
      <action name="SendToDesktop" to="4" follow="yes" />
    </keybind>

    <!-- Screenshot -->
    <keybind key="Print">
      <action name="Execute">
        <command>sh -c "grim ~/Pictures/screenshot_$(date +%Y%m%d_%H%M%S).png &amp;&amp; notify-send 'Screenshot captured'"</command>
      </action>
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <context name="Frame">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="TitleBar">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="default">
      <naturalScroll>no</naturalScroll>
      <tap>yes</tap>
      <tapButtonMap>lrm</tapButtonMap>
      <pointerSpeed>0.0</pointerSpeed>
      <accelProfile>adaptive</accelProfile>
    </device>
  </libinput>

</labwc_config>
