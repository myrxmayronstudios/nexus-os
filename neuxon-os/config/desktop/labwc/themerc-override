# ============================================================================
# Neuxon OS - Labwc Theme Override
# Strict Dark Monochrome Palette
# ============================================================================
# Window borders
border.width: 1
window.active.border.color: #262626
window.inactive.border.color: #262626

# Titlebar backgrounds
window.active.title.bg.color: #121212
window.inactive.title.bg.color: #080808

# Titlebar typography
window.active.label.text.color: #F2F2F2
window.inactive.label.text.color: #888888

# Window buttons (close, maximize, iconify)
window.active.button.unpressed.image.color: #F2F2F2
window.inactive.button.unpressed.image.color: #888888
window.active.button.pressed.image.color: #FFFFFF
window.active.button.hover.image.color: #FFFFFF
window.inactive.button.hover.image.color: #F2F2F2

# Menus (right-click desktop menu)
menu.border.width: 1
menu.border.color: #262626
menu.items.bg.color: #121212
menu.items.text.color: #F2F2F2
menu.items.active.bg.color: #FFFFFF
menu.items.active.text.color: #000000

# On-screen display (workspace switcher, resize popup)
osd.border.width: 1
osd.border.color: #262626
osd.bg.color: #121212
osd.label.text.color: #F2F2F2
