# ============================================================================
# Neuxon OS - Stealth Monochrome Glass Labwc Theme
# Surface: Void Black (#050505), Frosted Obsidian (#0E0E0EDB), Carbon (#141414)
# Specular Hairlines: #FFFFFF (Active), #2A2A2A (Inactive)
# Typography: JetBrains Mono Nerd Font, #F5F5F5 (Primary), #7A7A7A (Muted)
# ============================================================================

# Window borders
border.width: 1
window.active.border.color: #FFFFFF
window.inactive.border.color: #2A2A2A

# Titlebar backgrounds (Frosted Obsidian glassmorphism)
window.active.title.bg.color: #0E0E0EDB
window.inactive.title.bg.color: #050505DB

# Titlebar typography
window.active.label.text.color: #F5F5F5
window.inactive.label.text.color: #7A7A7A

# Window buttons (close, maximize, iconify)
window.active.button.unpressed.image.color: #F5F5F5
window.inactive.button.unpressed.image.color: #7A7A7A
window.active.button.pressed.image.color: #FFFFFF
window.active.button.hover.image.color: #FFFFFF
window.inactive.button.hover.image.color: #F5F5F5

# Menus (right-click desktop menu)
menu.border.width: 1
menu.border.color: #2A2A2A
menu.items.bg.color: #0E0E0EDB
menu.items.text.color: #F5F5F5
menu.items.active.bg.color: #FFFFFF
menu.items.active.text.color: #050505

# On-screen display (workspace switcher, resize popup)
osd.border.width: 1
osd.border.color: #FFFFFF
osd.bg.color: #0E0E0EDB
osd.label.text.color: #F5F5F5
