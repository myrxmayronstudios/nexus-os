# ============================================================================
# Neuxon OS - Stealth Monochrome Glass Labwc Theme
# 16-Bit Palette: Void Base #050508, Panel Surface #0E1015 (82% opacity: #0E1015D1)
# Hairlines: Active #A8B2C1, Inactive #1E222B
# Typography: JetBrains Mono Nerd Font, Primary #E2E8F0, Muted #8A96A8
# ============================================================================

# Window borders
border.width: 1
window.active.border.color: #A8B2C1
window.inactive.border.color: #1E222B

# Titlebar backgrounds (82% alpha translucent obsidian)
window.active.title.bg.color: #0E1015D1
window.inactive.title.bg.color: #050508D1

# Titlebar typography
window.active.label.text.color: #E2E8F0
window.inactive.label.text.color: #8A96A8

# Window buttons (close, maximize, iconify)
window.active.button.unpressed.image.color: #C8D0DC
window.inactive.button.unpressed.image.color: #8A96A8
window.active.button.pressed.image.color: #FFFFFF
window.active.button.hover.image.color: #FFFFFF
window.inactive.button.hover.image.color: #FFFFFF

# Menus (right-click desktop menu) - EXACT SPECIFICATION
menu.width.min: 230
menu.width.max: 320
menu.items.padding.x: 16
menu.items.padding.y: 8
menu.border.width: 1
menu.border.color: #1E222B
menu.items.bg.color: #0E1015D1
menu.items.text.color: #E2E8F0
menu.items.active.bg.color: #1E222B
menu.items.active.text.color: #FFFFFF

# On-screen display (workspace switcher, resize popup)
osd.border.width: 1
osd.border.color: #A8B2C1
osd.bg.color: #0E1015D1
osd.label.text.color: #E2E8F0
