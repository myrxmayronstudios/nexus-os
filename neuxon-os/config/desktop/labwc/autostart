#!/usr/bin/env bash
# ============================================================================
# Neuxon OS - Stealth Monochrome Glass Labwc Autostart
# Target: Raspberry Pi 3B+ (ARM64 Cortex-A53, VideoCore IV vc4-kms-v3d)
# ============================================================================
# Launched automatically by labwc on session start.
# All processes are backgrounded to avoid blocking compositor startup.
# ============================================================================

# --- Ensure seatd is running (for unprivileged Wayland sessions) ---
if ! pgrep -x seatd > /dev/null 2>&1; then
    sudo seatd -g video &
    sleep 0.3
fi

# --- Cursor theme and sizing ---
export XCURSOR_THEME="Adwaita"
export XCURSOR_SIZE=16

# --- Refresh font index for crisp JetBrains Mono rendering ---
fc-cache -fv > /tmp/fc-cache.log 2>&1 &

# --- Wallpaper Generation & Initialization ---
if [ ! -f /usr/share/backgrounds/neuxon-binary.png ]; then
    if [ -x /usr/local/bin/neuxon-gen-wallpaper ]; then
        /usr/local/bin/neuxon-gen-wallpaper >/dev/null 2>&1 || true
    fi
fi

if [ -f /usr/share/backgrounds/neuxon-binary.png ]; then
    if command -v swaybg &>/dev/null; then
        swaybg -i /usr/share/backgrounds/neuxon-binary.png -m fill &
    elif command -v wbg &>/dev/null; then
        wbg /usr/share/backgrounds/neuxon-binary.png &
    fi
elif [ -f /usr/share/backgrounds/neuxon/default.png ]; then
    swaybg -i /usr/share/backgrounds/neuxon/default.png -m fill &
else
    swaybg -c '#050508' &
fi
sleep 0.3

# --- Embed and Force Live btop Widget on Boot (Immediately After Wallpaper) ---
foot --app-id=neuxon-btop --window-size-chars=98x30 -e /usr/bin/btop --utf-force &
sleep 0.2

# --- Start Waybar (Top Status Bar & Centered Bottom Dock) with Logging ---
waybar -c ~/.config/waybar/config -s ~/.config/waybar/style.css > /tmp/waybar.log 2>&1 &
sleep 0.2

# --- Start Mako (Monochrome Toast Notifications) ---
mako > /tmp/mako.log 2>&1 &

# --- Start PipeWire / WirePlumber audio subsystem if present ---
if command -v pipewire &>/dev/null && ! pgrep -x pipewire >/dev/null 2>&1; then
    pipewire &
    sleep 0.2
    wireplumber &
fi

# --- Launch Remaining 5 Large Terminal Widgets ---
sleep 0.2
foot --app-id=neuxon-sysinfo --title="[ 01 // NEUXON ARCHITECTURE & SUBSYSTEMS ]" -e /usr/local/bin/neuxon-sysinfo-widget &
sleep 0.1
foot --app-id=neuxon-telemetry --title="[ 03 // LIVE HARDWARE & THERMAL TELEMETRY ]" -e /usr/local/bin/neuxon-telemetry-widget &
sleep 0.1
foot --app-id=neuxon-net --title="[ 04 // CHRONO & NETWORK TELEMETRY ]" -e /usr/local/bin/neuxon-net-widget &
sleep 0.1
foot --app-id=neuxon-notes --title="[ 05 // NEUXON VFS SCRATCHPAD & MEMO ]" -e /usr/local/bin/neuxon-notes-widget &
sleep 0.1
foot --app-id=neuxon-matrix --title="[ 06 // KERNEL DMESG & RING IPC STREAM ]" -e /usr/local/bin/neuxon-matrix-widget &

# --- Start Autonomous Self-Healing Daemon ---
/usr/local/bin/neuxon-doctor --daemon &

# --- Import environment into systemd / dbus ---
dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_TYPE \
    XDG_SESSION_DESKTOP 2>/dev/null &
