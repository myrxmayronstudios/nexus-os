#!/usr/bin/env bash
# ============================================================================
# Neuxon OS v5.0 - Stealth 16-Bit Obsidian Glass Labwc Autostart
# Target: Raspberry Pi 3B+ (ARM64 Cortex-A53, VideoCore IV vc4-kms-v3d)
# ============================================================================
# Launched automatically by labwc on session startup.
# All persistent services are backgrounded cleanly to avoid blocking compositor.
# ============================================================================

# --- 1. Wait for Wayland display socket to become ready ---
for _ in $(seq 1 30); do
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]; then
        break
    fi
    sleep 0.1
done

# --- 2. Ensure seatd is running (for unprivileged Wayland sessions) ---
if ! pgrep -x seatd > /dev/null 2>&1; then
    sudo seatd -g video &
    sleep 0.2
fi

# --- 3. Cursor theme, font cache & runtime environment ---
export XCURSOR_THEME="Adwaita"
export XCURSOR_SIZE=18
fc-cache -fv > /tmp/fc-cache.log 2>&1 &

# Ensure user directories and startpage exist
mkdir -p "${HOME}/.local/share/neuxon" "${HOME}/Pictures/Screenshots"
if [ ! -f "${HOME}/.local/share/neuxon/startpage.html" ] && [ -f /usr/local/share/neuxon/startpage.html ]; then
    cp /usr/local/share/neuxon/startpage.html "${HOME}/.local/share/neuxon/startpage.html"
fi

# --- 4. Wallpaper Generation & Layer-Shell Initialization ---
if [ ! -f /usr/share/backgrounds/neuxon-binary.png ]; then
    if [ -x /usr/local/bin/neuxon-gen-wallpaper ]; then
        /usr/local/bin/neuxon-gen-wallpaper >/dev/null 2>&1 || true
    fi
fi

if [ -f /usr/share/backgrounds/neuxon-binary.png ]; then
    if command -v swaybg &>/dev/null; then
        swaybg -i /usr/share/backgrounds/neuxon-binary.png -m fill &
    elif command -v wbg &>/dev/null; then
        wbg /usr/share/backgrounds/neuxon-binary.png &
    fi
elif [ -f /usr/share/backgrounds/neuxon/default.png ]; then
    swaybg -i /usr/share/backgrounds/neuxon/default.png -m fill &
else
    swaybg -c '#050608' &
fi
sleep 0.3

# --- 5. Embed and Force Live btop Widget on Boot (Immediately After Wallpaper) ---
# Launches strictly as the embedded desktop widget instance (app-id: neuxon-btop)
if [ -x /usr/local/bin/neuxon-btop-widget ]; then
    /usr/local/bin/neuxon-btop-widget &
else
    foot --app-id=neuxon-btop --title="[ 02 // TASK MATRIX & CPU COMPUTE CLUSTERS ]" --window-size-chars=98x30 -e /usr/bin/btop --utf-force &
fi
sleep 0.2

# --- 6. Start Waybar (Top Windows-Familiar Taskbar & Centered Floating Dock) ---
WAYBAR_STYLE="${HOME}/.config/waybar/style.css"
[ -f "${WAYBAR_STYLE}" ] || WAYBAR_STYLE="/etc/xdg/waybar/style.css"

if [ -f "${HOME}/.config/waybar/config-top.jsonc" ]; then
    waybar -c "${HOME}/.config/waybar/config-top.jsonc" -s "${WAYBAR_STYLE}" > /tmp/waybar-top.log 2>&1 &
fi

if [ -f "${HOME}/.config/waybar/config-dock.jsonc" ]; then
    waybar -c "${HOME}/.config/waybar/config-dock.jsonc" -s "${WAYBAR_STYLE}" > /tmp/waybar-dock.log 2>&1 &
fi

# Fallback if separate configs are not used
if ! pgrep -x waybar >/dev/null 2>&1; then
    if [ -f "${HOME}/.config/waybar/config" ]; then
        waybar -c "${HOME}/.config/waybar/config" -s "${WAYBAR_STYLE}" > /tmp/waybar.log 2>&1 &
    elif [ -f /etc/xdg/waybar/config ]; then
        waybar -c /etc/xdg/waybar/config -s "${WAYBAR_STYLE}" > /tmp/waybar.log 2>&1 &
    fi
fi
sleep 0.2

# --- 7. Start Mako (Monochrome Toast Notifications) ---
mako > /tmp/mako.log 2>&1 &

# --- 8. Start PipeWire / WirePlumber audio subsystem if present ---
if command -v pipewire &>/dev/null && ! pgrep -x pipewire >/dev/null 2>&1; then
    pipewire &
    sleep 0.2
    wireplumber &
fi

# --- 9. Launch Remaining Desktop Widgets ---
sleep 0.2
foot --app-id=neuxon-sysinfo --title="[ 01 // NEUXON ARCHITECTURE & SUBSYSTEMS ]" -e /usr/local/bin/neuxon-sysinfo-widget &
sleep 0.1
foot --app-id=neuxon-telemetry --title="[ 03 // LIVE HARDWARE & THERMAL TELEMETRY ]" -e /usr/local/bin/neuxon-telemetry-widget &
sleep 0.1
foot --app-id=neuxon-net --title="[ 04 // CHRONO & NETWORK TELEMETRY ]" -e /usr/local/bin/neuxon-net-widget &
sleep 0.1
foot --app-id=neuxon-notes --title="[ 05 // NEUXON VFS SCRATCHPAD & MEMO ]" -e /usr/local/bin/neuxon-notes-widget &
sleep 0.1
foot --app-id=neuxon-matrix --title="[ 06 // KERNEL DMESG & RING IPC STREAM ]" -e /usr/local/bin/neuxon-matrix-widget &

# --- 10. Start Autonomous Self-Healing Daemon Watchdog ---
/usr/local/bin/neuxon-doctor --daemon &

# --- 11. Import environment into systemd / dbus ---
dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_TYPE \
    XDG_SESSION_DESKTOP 2>/dev/null &
