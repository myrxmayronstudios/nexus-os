<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">

  <menu id="root-menu" label="NEUXON // OS">

    <!-- Self-Healing & Diagnostics -->
    <item label="◆ Neuxon Doctor (Audit &amp; Repair)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch doctor</command>
      </action>
    </item>
    <item label="◈ Neuxon Control Center">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch control</command>
      </action>
    </item>
    <item label="◇ System Telemetry HUD">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-hud</command>
      </action>
    </item>

    <separator />

    <!-- Core Applications -->
    <item label="Terminal Shell (Foot)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch foot</command>
      </action>
    </item>
    <item label="Web Browser (Chromium / Min)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch browser</command>
      </action>
    </item>
    <item label="App Launcher (Fuzzel)">
      <action name="Execute">
        <command>fuzzel</command>
      </action>
    </item>
    <item label="File Manager (Yazi)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch yazi</command>
      </action>
    </item>
    <item label="Dual-Pane Files (Midnight Commander)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch mc</command>
      </action>
    </item>
    <item label="GUI File Manager (PCManFM)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch pcmanfm</command>
      </action>
    </item>
    <item label="Micro Text Editor">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch micro</command>
      </action>
    </item>
    <item label="Helix Code Editor">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch hx</command>
      </action>
    </item>
    <item label="GUI Text Editor (Mousepad)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch mousepad</command>
      </action>
    </item>

    <separator />

    <!-- Media & Productivity Applications -->
    <item label="Music Player (C* Music Player - cmus)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch music</command>
      </action>
    </item>
    <item label="Image Viewer (imv)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch image</command>
      </action>
    </item>
    <item label="PDF &amp; Document Viewer (Zathura)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch zathura</command>
      </action>
    </item>
    <item label="Scientific Calculator (Galculator)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch galculator</command>
      </action>
    </item>
    <item label="Disk Usage Analyzer (ncdu)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch ncdu</command>
      </action>
    </item>

    <separator />

    <!-- System Telemetry & Utilities -->
    <item label="Task Matrix (btop)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch btop</command>
      </action>
    </item>
    <item label="System Spec (Fastfetch)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch fastfetch</command>
      </action>
    </item>
    <item label="LazyGit UI">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch lazygit</command>
      </action>
    </item>
    <item label="LazyDocker UI">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch lazydocker</command>
      </action>
    </item>
    <item label="Regenerate Binary Wallpaper">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-gen-wallpaper</command>
      </action>
    </item>

    <separator />

    <!-- Session Actions -->
    <item label="Lock Screen">
      <action name="Execute">
        <command>swaylock -f -c 050505 --ring-color FFFFFF --inside-color 0E0E0E --line-color 2A2A2A --text-color F5F5F5</command>
      </action>
    </item>
    <item label="Logout">
      <action name="Exit" />
    </item>
    <item label="Reboot">
      <action name="Execute">
        <command>systemctl reboot</command>
      </action>
    </item>
    <item label="Power Off">
      <action name="Execute">
        <command>systemctl poweroff</command>
      </action>
    </item>

  </menu>

</openbox_menu>
