<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">

  <!-- Desktop Background Right-Click Context Menu -->
  <menu id="root-menu" label="NEUXON OS">
    <item label="❖ Start / Search Apps (Win)">
      <action name="Execute">
        <command>fuzzel</command>
      </action>
    </item>

    <separator />

    <item label=">_ Open Terminal (Win+Enter)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-launch terminal</command>
      </action>
    </item>
    <item label="📁 File Explorer (Win+E)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-files</command>
      </action>
    </item>
    <item label="🌐 Web Browser (Chromium)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-browser</command>
      </action>
    </item>
    <item label="🖩 Calculator">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-calc</command>
      </action>
    </item>
    <item label="📝 Notes &amp; Text Editor">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-notes</command>
      </action>
    </item>
    <item label="📊 System Monitor (Ctrl+Shift+Esc)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-btop-open</command>
      </action>
    </item>

    <separator />

    <item label="⚙ Settings &amp; Control Center (Win+C)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-settings</command>
      </action>
    </item>
    <item label="🖥 Display &amp; Wallpaper">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-settings display</command>
      </action>
    </item>
    <item label="🛠 Refresh &amp; Heal Desktop">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-doctor --gui</command>
      </action>
    </item>

    <separator />

    <item label="⏻ Power Options (Win+P)">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-power</command>
      </action>
    </item>
  </menu>

  <!-- Window Titlebar Right-Click Menu -->
  <menu id="client-menu" label="Window Operations">
    <item label="[ _ ] Minimize (Win+Down)">
      <action name="Iconify" />
    </item>
    <item label="[ □ ] Maximize / Restore (Win+Up)">
      <action name="ToggleMaximize" />
    </item>
    <item label="[ 🠜 ] Snap Left (Win+Left)">
      <action name="SnapToEdge" direction="left" />
    </item>
    <item label="[ 🠞 ] Snap Right (Win+Right)">
      <action name="SnapToEdge" direction="right" />
    </item>
    <item label="[ ⮝ ] Always on Top">
      <action name="ToggleAlwaysOnTop" />
    </item>
    <separator />
    <item label="[ × ] Close (Alt+F4)">
      <action name="Close" />
    </item>
  </menu>

</openbox_menu>
