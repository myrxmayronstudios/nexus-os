<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">

  <menu id="root-menu" label="NEUXON // OS">

    <!-- Primary Control Center -->
    <item label="◆ Neuxon Control Center">
      <action name="Execute">
        <command>foot -a neuxon-control -T "Neuxon Control Center" /usr/local/bin/neuxon-control</command>
      </action>
    </item>
    <item label="◇ System HUD Overlay">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-hud</command>
      </action>
    </item>
    <item label="◈ Toggle btop Gadget">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-btop-gadget</command>
      </action>
    </item>

    <separator />

    <!-- Core Applications -->
    <item label="Terminal (Foot)">
      <action name="Execute">
        <command>foot</command>
      </action>
    </item>
    <item label="App Launcher (Fuzzel)">
      <action name="Execute">
        <command>fuzzel</command>
      </action>
    </item>
    <item label="Web Browser">
      <action name="Execute">
        <command>/usr/local/bin/neuxon-browser</command>
      </action>
    </item>
    <item label="File Manager (Yazi)">
      <action name="Execute">
        <command>foot -e yazi</command>
      </action>
    </item>
    <item label="Micro Text Editor">
      <action name="Execute">
        <command>foot -e micro</command>
      </action>
    </item>
    <item label="Helix Code Editor">
      <action name="Execute">
        <command>foot -e hx</command>
      </action>
    </item>

    <separator />

    <!-- System Monitoring & Tools -->
    <item label="BTOP Monitor (Monochrome)">
      <action name="Execute">
        <command>foot -e btop</command>
      </action>
    </item>
    <item label="Bottom Hardware Graphs (BTM)">
      <action name="Execute">
        <command>foot -e btm</command>
      </action>
    </item>
    <item label="LazyGit UI">
      <action name="Execute">
        <command>foot -e lazygit</command>
      </action>
    </item>
    <item label="LazyDocker UI">
      <action name="Execute">
        <command>foot -e lazydocker</command>
      </action>
    </item>
    <item label="Kew Music Player">
      <action name="Execute">
        <command>foot -e kew</command>
      </action>
    </item>

    <separator />

    <!-- Session Actions -->
    <item label="Lock Screen">
      <action name="Execute">
        <command>swaylock -f -c 050505 --ring-color FFFFFF --inside-color 0E0E0E --line-color 2A2A2A --text-color F5F5F5</command>
      </action>
    </item>
    <item label="Logout">
      <action name="Exit" />
    </item>
    <item label="Reboot">
      <action name="Execute">
        <command>systemctl reboot</command>
      </action>
    </item>
    <item label="Power Off">
      <action name="Execute">
        <command>systemctl poweroff</command>
      </action>
    </item>

  </menu>

</openbox_menu>
